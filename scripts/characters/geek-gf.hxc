import funkin.play.character.AnimateAtlasCharacter;
import funkin.play.character.CharacterType;
import funkin.play.PlayState;
import flixel.addons.effects.FlxTrail;

/**
 * One of a few states that GF can be looking in.
 */
enum GFLookState
{
  LEFT;
  RIGHT;
}

class GirlfriendGeekCharacter extends AnimateAtlasCharacter
{
  var lastState:GFLookState = GFLookState.RIGHT;

  function new() super('gf-geek');

  override function onUpdate(event:UpdateScriptEvent):Void {
      super.onUpdate(event);
    }

  override function onSongEvent(scriptEvent:SongEventScriptEvent) {
    super.onSongEvent(scriptEvent);
    if (scriptEvent.eventData.eventKind == "FocusCamera")
    {
      var value = scriptEvent.eventData.getInt("char");
      switch (value)
      {
        case 0:
          lookRight();
        case 1:
          lookLeft();
        case 2:
          lookCenter();
        default:
      }
    }
  }

  function lookLeft():Void
  {
    lastState = GFLookState.LEFT;
    this.playAnimation("leftlook", true);
    trace('GF looks left, last known state: $lastState');
  }

  function lookRight():Void
  {
    lastState = GFLookState.RIGHT;
    this.playAnimation("rightlook", true);
    trace('GF looks right, last known state: $lastState');
  }

  function lookCenter():Void
  {
    if (lastState == GFLookState.LEFT) {
      this.playAnimation("leftreturn", true);
      trace('GF looks to the center, previously looking left');
    } else {
      this.playAnimation("rightreturn", true);
      trace('GF looks to the center, previously looking right');
    }
  }
}
