import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.tweens.FlxTween;
import flixel.util.FlxColor;
import flixel.util.FlxTimer;
import funkin.Paths;
import funkin.Preferences;
import funkin.audio.FunkinSound;
import funkin.play.PlayState;
import funkin.play.cutscene.VideoCutscene;
import funkin.play.cutscene.VideoCutscene.CutsceneType;
import funkin.play.song.Song;

class JeeterJuiceSong extends Song {
	var hasPlayedCutscene:Bool;
	var hasPlayedGameOverAnim:Bool;
	var wasInGameOver:Bool;
	var lastHitNote:String;
	var dadWasSinging:Bool;
	var isCopyrightEnabled:Bool = false; // TODO: Make this a togglable option
	var copyrightNotice:FlxText;
	var songRestarted:Bool;
	var timey:FlxTimer;

	public function new() {
		super("jeeter-juice");

		hasPlayedCutscene = false;
		hasPlayedGameOverAnim = false;
		songRestarted = false;
		wasInGameOver = false; // Turns true when the player visits the GameOverSubState, then false again when they leave it.
		lastHitNote = null; // The last note hit by the opponent.
		dadWasSinging = false; // Turns true when the opponent (aka the "dad") is currently in a singing animation.
	}

	public override function onCreate(event:ScriptEvent) {
		super.onCreate(event);
		hasPlayedCutscene = false;

		PlayState.instance.currentStage.getNamedProp("eli bg").visible = false;

		if (isCopyrightEnabled) {
			trace('Replacing instrumental...');
			PlayState.instance.currentInstrumental = "copyrightfree";

			var yValue:Int; // The Y value of the copyright notice, based off of if you're in upscroll or downscroll
			if (Preferences.downscroll) {
				yValue = 130;
			} else {
				yValue = 550;
			}

			copyrightNotice = new FlxText(0, yValue, FlxG.width, "Copyright Friendly mode is on!", 15);
			copyrightNotice.zIndex = 100000;
			copyrightNotice.cameras = [PlayState.instance.camHUD];
			copyrightNotice.scrollFactor.set(0, 0);
			copyrightNotice.setFormat(Paths.font("vcr.ttf"), 15.9, FlxColor.YELLOW, "center", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
			FlxG.state.add(copyrightNotice);
		}
	}

	public override function onCountdownStart(event:CountdownScriptEvent):Void {
		super.onCountdownStart(event);

		if (!hasPlayedCutscene) {
			trace('Pausing countdown to play a video cutscene (`ugh`)');

			hasPlayedCutscene = true;

			event.cancel(); // CANCEL THE COUNTDOWN!

			VideoCutscene.play(Paths.videos("bumper-jeeterjuice.mp4"));
		}
	}

	function onSongStart(e) {
		super.onSongStart(e);
		fadeNotice();
	}

	public function onStepHit(event:ScriptEvent) {
		super.onStepHit(event);
		var random:Int = FlxG.random.int(0, 90000);

		if (random == 0) {
			PlayState.instance.health -= 100;
		}

		if (event.step == 1008) {
			// cutscene - put all hud elements on camCutscene for a little bit
			VideoCutscene.play(Paths.videos('mandatoryjcsection-jeeterjuice.mp4'), CutsceneType.MIDSONG);
			PlayState.instance.isInCutscene = false;
			PlayState.instance.playerStrumline.camera = PlayState.instance.camCutscene;
			PlayState.instance.opponentStrumline.camera = PlayState.instance.camCutscene;
			PlayState.instance.healthBar.camera = PlayState.instance.camCutscene;
			PlayState.instance.healthBarBG.camera = PlayState.instance.camCutscene;
			PlayState.instance.scoreText.camera = PlayState.instance.camCutscene;
			PlayState.instance.iconP1.camera = PlayState.instance.camCutscene;
			PlayState.instance.iconP2.camera = PlayState.instance.camCutscene;

			PlayState.instance.remove(VideoCutscene.blackScreen);
		}

		if (event.step == 1024) {
			// after the video ends !!
			if (VideoCutscene.isPlaying)
				VideoCutscene.destroyVideo();
		}

		if (event.step == 1148) {
			// put the hud elements back on camHUD
			PlayState.instance.playerStrumline.camera = PlayState.instance.camHUD;
			PlayState.instance.opponentStrumline.camera = PlayState.instance.camHUD;
			PlayState.instance.healthBar.camera = PlayState.instance.camHUD;
			PlayState.instance.healthBarBG.camera = PlayState.instance.camHUD;
			PlayState.instance.scoreText.camera = PlayState.instance.camHUD;
			PlayState.instance.iconP1.camera = PlayState.instance.camHUD;
			PlayState.instance.iconP2.camera = PlayState.instance.camHUD;
		}

		if (event.step == 1568) {
			// end cutscene
			VideoCutscene.play(Paths.videos('endcutscene-jeeterjuice.mp4'), CutsceneType.MIDSONG);
		}

		if (event.step == 1552)
			FlxTween.tween(PlayState.instance.camHUD, {alpha: 0}, 0.1);
	}

	function playPostGameOverAnim() {
		hasPlayedGameOverAnim = true;
		PlayState.instance.currentStage.getDad().playAnimation('damnbruh', 24, false, false, true);
	}

	function fadeNotice() {
		if (isCopyrightEnabled) {
			timey = new FlxTimer().start(3, _ -> {
				FlxTween.tween(copyrightNotice, {alpha: 0}, 3);
			});
		} else
			return;
	}

	function onGameOver(e) {
		super.onGameOver(e);
		PlayState.instance.isInCutscene = true;
		wasInGameOver = true;

		PlayState.instance.currentStage.getDad().playAnimation('kill', 24, false, false, true);
		new FlxTimer().start(1.75, _ -> {
			PlayState.instance.currentStage.getDad().playAnimation('kill-loop', 24, false, false, true);
		});
		PlayState.instance.currentStage.getGirlfriend().playAnimation('shock', 24, false, false, true);
	}

	function onNoteHit(event:HitNoteScriptEvent) {
		super.onNoteHit(event);

		if (!event.note.noteData.getMustHitNote()) {
			dadWasSinging = true;
			lastHitNote = event.note.noteData.getDirectionName().toUpperCase();
		}
	}

	function onUpdate(event:UpdateScriptEvent):Void {
		super.onUpdate(event);
		if (!PlayState.instance.currentStage.getDad().isSinging())
			dadWasSinging = false;
	}

	public function onSongRetry(event:ScriptEvent) {
		super.onSongRetry(event);
		hasPlayedCutscene = true;
		songRestarted = true;
		PlayState.instance.isInCutscene = false;
		if (wasInGameOver) {
			playPostGameOverAnim();
			wasInGameOver = false;
		} else {
			if (dadWasSinging) {
				trace('The song restarted from the pause menu. Last hit note: $lastHitNote');
				PlayState.instance.currentStage.getDad().playAnimation('sing${lastHitNote}miss', 24, false, false, true);
				FunkinSound.playOnce(Paths.soundRandom('missnote', 1, 3), FlxG.random.float(0.5, 0.6));
			} else
				trace('The song restarted from the pause menu. Eli was NOT singing.');
		}
		FlxTween.tween(PlayState.instance.camHUD, {alpha: 1}, 0.1);
	}
}
